    "commander": "^12.0.0",
    "creem": "1.4.4",
    "ora": "^8.0.0",
    "stripe": "^20.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "waffo",
    "pancake",
    "stripe",
    "creem",
    "migration",
    "payments",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waffo-com/waffo-pancake-migrate.git"
