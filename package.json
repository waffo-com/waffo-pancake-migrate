{
  "name": "@waffo/pancake-migrate",
  "version": "0.2.0",
  "description": "Migrate products and settings from Stripe or Creem to Waffo Pancake",
  "type": "module",
  "bin": {
    "pancake-migrate": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@waffo/pancake-ts": "0.4.2",
    "chalk": "^5.3.0",
