# Local migration test access. Never commit actual credentials.
# Products Read only; enter the key privately in .env.test.
DODO_PAYMENTS_API_KEY=

# Waffo destination for manual test migration; not needed for preview.
WAFFO_MERCHANT_ID=
# Absolute path to your private key file. Quote paths containing spaces.
WAFFO_PRIVATE_KEY_PATH=
WAFFO_STORE_ID=

# Creem test-mode API key (creem_test_...).
CREEM_API_KEY=
